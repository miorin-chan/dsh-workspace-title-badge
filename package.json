{
  "name": "@miorin/dsh-workspace-title-badge",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Show the session's workspace beside its title.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "header",
    "session",
    "label",
    "context-menu"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "DESIGN.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/DETAIL.zh.md",
    "docs/assets/screenshots/entry-dark.png",
    "docs/assets/screenshots/entry-light.png",
    "docs/assets/screenshots/main-dark.png",
    "docs/assets/screenshots/main-light.png",
    "src",
    "scripts",
    "tsconfig.json",
    "tsconfig.tools.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit --",
    "test:unit": "node --test",
    "check": "npm run build:tools && npm run test:unit && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check",
    "build:tools": "tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-workspace-title-badge.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-workspace-title-badge#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-workspace-title-badge/issues"
  }
}
